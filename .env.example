# Copy to .env.local and fill in. .env*.local is gitignored — never commit a real key.

# Google Gemini — powers the "AI Agent" tab in the support widget.
# Get one at https://aistudio.google.com/apikey
# Server-side only (no NEXT_PUBLIC_ prefix), so the key is never sent to the browser.
# If this is missing or invalid, /api/chat falls back to the grounded offline
# responder in src/lib/chat/offline-engine.ts — the widget keeps working.
GEMINI_API_KEY=

# Optional. Defaults to gemini-2.5-flash, which is the right trade-off for a
# website assistant (fast, inexpensive). Use gemini-2.5-pro for harder reasoning.
# GEMINI_MODEL=gemini-2.5-flash
